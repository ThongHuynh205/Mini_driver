<Window x:Class="Mini_driver.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini_driver"
        Height="400"
        Width="500">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock
                Text="MINI DRIVER"
                FontSize="24"
                Margin="0 0 0 20"/>

            <TextBox
                x:Name="txtUsername"
                Height="35"
                Margin="0 0 0 10"/>

            <PasswordBox
                x:Name="txtPassword"
                Height="35"
                Margin="0 0 0 20"/>

            <Button
                Content="LOGIN"
                Height="40"
                Click="Login_Click"/>

            <Button
                Content="UPLOAD FILE"
                Height="40"
                Margin="0 20 0 0"
                Click="Upload_Click"/>

            <TextBlock
                x:Name="txtStatus"
                FontSize="16"
                Margin="0 20 0 0"/>

        </StackPanel>

    </Grid>

</Window>